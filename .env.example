# Copy to .env and adjust. docker compose loads .env automatically.
JWT_SECRET=change-me-in-production
PUBLIC_URL=http://localhost:3010

# Google OAuth — leave empty to hide the Google sign-in button.
# Authorized redirect URI: http://localhost:3010/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Microsoft 365 shown; any SMTP relay works). The mailbox needs SMTP AUTH
# enabled, and with MFA you must use an app password. Leave SMTP_HOST empty to
# keep notifications in-app only.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=plm-notifications@yourtenant.onmicrosoft.com
SMTP_PASS=
SMTP_FROM=plm-notifications@yourtenant.onmicrosoft.com

# Webhooks: refuse private/loopback targets (recommended for internet-facing deploys).
# Link-local / cloud-metadata hosts are always refused regardless of this setting.
WEBHOOK_BLOCK_PRIVATE_HOSTS=false
# Max JSON body size — bulk ERP CSV imports travel in the request body.
JSON_BODY_LIMIT=25mb

# --- Internet-facing deployments -------------------------------------------
# Never create the demo product or the demo logins (their passwords are public).
SEED_DEMO_DATA=true
# Disable self-registration; an admin creates accounts instead. Bootstrap the
# first one with: docker compose exec api npm run create-admin -- <email> <password>
ALLOW_REGISTRATION=true
